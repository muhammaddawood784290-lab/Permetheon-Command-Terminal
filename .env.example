# ==========================================
# PCT — Permetheon Command Terminal
# Environment Configuration Example
# ==========================================

# ------------------------------------------
# Application
# ------------------------------------------
NODE_ENV=development
PORT=5000

# Production:
# NODE_ENV=production
# PORT=5000


# ------------------------------------------
# Frontend
# ------------------------------------------
FRONTEND_URL=http://localhost:5173

# Production:
# FRONTEND_URL=https://pct.permetheon.com


# ------------------------------------------
# MySQL Database
# ------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pct
DB_USER=root
DB_PASSWORD=


# ------------------------------------------
# Authentication
# ------------------------------------------
AUTH_SECRET=change_this_to_a_long_random_secret
SESSION_SECRET=change_this_to_a_long_random_secret


# ------------------------------------------
# File Storage
# ------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100


# ------------------------------------------
# Security
# ------------------------------------------
CORS_ORIGIN=http://localhost:5173


# ------------------------------------------
# Application Settings
# ------------------------------------------
APP_NAME=Permetheon Command Terminal
APP_URL=http://localhost:5173


# ------------------------------------------
# Production Configuration
# ------------------------------------------
# APP_URL=https://pct.permetheon.com
# CORS_ORIGIN=https://pct.permetheon.com