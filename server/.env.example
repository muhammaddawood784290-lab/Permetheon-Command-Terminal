# ==========================================
# PCT Server — Environment Configuration
# Copy to .env and fill in real values.
# Real secrets live in .env (git-ignored).
# ==========================================

# ------------------------------------------
# Application
# ------------------------------------------
NODE_ENV=development
PORT=5000


# ------------------------------------------
# Frontend (CORS origin)
# ------------------------------------------
FRONTEND_URL=http://localhost:5173


# ------------------------------------------
# MySQL Database
# (matches DATABASE.md / root .env.example)
# ------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pct
DB_USER=root
DB_PASSWORD=


# ------------------------------------------
# Authentication
# Phase 2: HttpOnly cookie + server-side session state.
# Placeholders only — never commit real secrets.
# ------------------------------------------
AUTH_SECRET=change_this_to_a_long_random_secret
SESSION_SECRET=change_this_to_a_long_random_secret

# Session cookie name + lifetime (milliseconds).
# Default lifetime is 8 hours.
SESSION_COOKIE_NAME=pct_sid
SESSION_COOKIE_MAX_AGE_MS=28800000

# Rate-limit placeholders for /api/auth/login (per IP).
# Disabled by default; values shown are illustrative.
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_MS=60000


# ------------------------------------------
# File Storage
# (placeholders — uploads not implemented yet)
# ------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100
